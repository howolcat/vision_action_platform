# ==================================================
# 사용법: cp .env.example .env  후 값을 바꾸세요.
# .env는 .gitignore에 있어 GitHub에 올라가지 않습니다. 실제 비밀번호·카메라 주소는 .env에만!
# ==================================================

# ---------- Django ----------
# 새 키 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- PostgreSQL (compose의 postgres 서비스와 django가 같이 사용) ----------
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me

# ---------- Celery / FastAPI ----------
# Docker에서는 compose.yaml이 redis://redis:6379, http://fastapi:8000 으로 덮어씁니다.
FASTAPI_TIMEOUT=300

# ---------- IP Webcam (수업에서 허용한 카메라만 등록) ----------
# 형식: 이름=주소,이름=주소   (사용자는 화면에서 "이름"만 고를 수 있음)
# Android 'IP Webcam' 앱 기준 주소: http://<휴대폰 IP>:8080/video
IP_WEBCAM_SOURCES=phone1=http://<CAMERA_IP>:8080/video
WEBCAM_CAPTURE_SECONDS=8

# ---------- AI 추론 ----------
UNCERTAIN_THRESHOLD=0.4
MAX_FRAMES=1800
MAX_UPLOAD_MB=100
